{
  "name": "@casys/mcp-modelica",
  "version": "0.1.3",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./server": "./server.ts"
  },
  "publish": {
    "include": [
      "mod.ts",
      "server.ts",
      "src/**/*.ts",
      "models/**/*.mo",
      "scenarios/**/*.json",
      "README.md",
      "LICENSE",
      "Dockerfile"
    ],
    "exclude": [
      "tests/",
      "**/*_test.ts",
      "**/*.test.ts"
    ]
  },
  "tasks": {
    "serve": "deno run --allow-read=models,scenarios,src,mcp-server.yaml --allow-write=runs --allow-run --allow-env --allow-net=127.0.0.1:3016 server.ts --http --port=3016",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env tests/",
    "test:omc": "RUN_OMC_INTEGRATION=1 deno test --allow-read --allow-write --allow-run --allow-env tests/omc_integration_test.ts",
    "check": "deno check mod.ts server.ts",
    "fmt": "deno fmt --check deno.json mod.ts server.ts src tests",
    "lint": "deno lint mod.ts server.ts src tests"
  },
  "imports": {
    "@casys/mcp-server": "jsr:@casys/mcp-server@^0.22.0",
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "@std/path": "jsr:@std/path@^1.1.0"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "compilerOptions": {
    "strict": true
  }
}
